# Copiar como .env (o cargar en la Run Configuration del IDE / en Render) si hace falta cambiar algo.
# Todas tienen valor por defecto en application.yml, pensado para desarrollo local.

# Base de datos: la URL JDBC se arma con estas variables...
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sistema_nacional
DB_SSLMODE=prefer
# ...salvo que se defina DB_URL, que pisa a las cuatro anteriores.
# DB_URL=jdbc:postgresql://localhost:5434/sistema_nacional
DB_USER=sistema_nacional
DB_PASSWORD=sistema_nacional

SERVER_PORT=8082
CORS_ORIGINS=http://localhost:5173
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Seguridad. En producción JWT_SECRET es obligatorio (mínimo 32 caracteres) y COOKIE_SECURE=true.
# JWT_SECRET=
COOKIE_SECURE=false
JWT_EXPIRATION=86400000
